+static int open_self_status(CPUArchState *cpu_env, int fd)
+{
+    /* TIZEN-PROCSTATUS: guest-shaped status so the CLR's memory
+       heuristics see the emulated process instead of host qemu. */
+    dprintf(fd, "Name:\tHomeSidebar.dll\n");
+    dprintf(fd, "Umask:\t0022\n");
+    dprintf(fd, "State:\tR (running)\n");
+    dprintf(fd, "Tgid:\t5000\nPid:\t5000\nPPid:\t1\n");
+    dprintf(fd, "TracerPid:\t0\n");
+    dprintf(fd, "Uid:\t5001\t5001\t5001\t5001\n");
+    dprintf(fd, "Gid:\t5001\t5001\t5001\t5001\n");
+    dprintf(fd, "FDSize:\t64\n");
+    dprintf(fd, "VmPeak:\t  412000 kB\n");
+    dprintf(fd, "VmSize:\t  389000 kB\n");
+    dprintf(fd, "VmLck:\t       0 kB\n");
+    dprintf(fd, "VmHWM:\t  330000 kB\n");
+    dprintf(fd, "VmRSS:\t  320000 kB\n");
+    dprintf(fd, "VmData:\t   90000 kB\n");
+    dprintf(fd, "VmStk:\t     136 kB\n");
+    dprintf(fd, "VmExe:\t   20000 kB\n");
+    dprintf(fd, "VmLib:\t  120000 kB\n");
+    dprintf(fd, "VmPTE:\t    1200 kB\n");
+    dprintf(fd, "VmSwap:\t       0 kB\n");
+    dprintf(fd, "Threads:\t10\n");
+    return 0;
+}
